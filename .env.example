# HTTP
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
OFFERS_TTL_SECONDS=3600

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=hotel-offers
WORKFLOW_TIMEOUT_MS=30000

# Suppliers (the mock suppliers are served by this same application)
SUPPLIER_A_URL=http://localhost:3000/supplierA/hotels
SUPPLIER_B_URL=http://localhost:3000/supplierB/hotels
SUPPLIER_TIMEOUT_MS=3000

# Simulate a supplier outage (true/false) to demonstrate graceful degradation
SUPPLIER_A_FORCE_FAILURE=false
SUPPLIER_B_FORCE_FAILURE=false
