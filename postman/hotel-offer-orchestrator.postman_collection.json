{
  "info": {
    "name": "Hotel Offer Orchestrator",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Set the baseUrl collection variable (default http://localhost:3000)."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Get Delhi hotels",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('8 deduplicated hotels', () => pm.expect(body).to.have.length(8));",
              "pm.test('Holtin comes from Supplier B at 5340', () => {",
              "  const h = body.find(x => x.name === 'Holtin');",
              "  pm.expect(h).to.eql({ name: 'Holtin', price: 5340, supplier: 'Supplier B', commissionPct: 20 });",
              "});",
              "pm.test('Radison comes from Supplier A at 5900', () => pm.expect(body.find(x => x.name === 'Radison').supplier).to.eql('Supplier A'));",
              "pm.test('no supplier-internal fields', () => body.forEach(h => pm.expect(h).to.not.have.property('hotelId')));",
              "pm.test('sorted by price ascending', () => pm.expect(body.map(h => h.price)).to.eql([...body.map(h => h.price)].sort((a, b) => a - b)));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/hotels?city=delhi",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "hotels"
          ],
          "query": [
            {
              "key": "city",
              "value": "delhi"
            }
          ]
        },
        "description": ""
      }
    },
